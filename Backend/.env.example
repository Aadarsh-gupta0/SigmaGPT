# ── SigmaGPT backend ────────────────────────────────────────────────────────
# Every value here is optional. With an empty .env the server still answers,
# using the keyless Pollinations gateway and local JSON file storage.

PORT=8080
CORS_ORIGIN=*

# ── Storage ────────────────────────────────────────────────────────────────
# Leave MONGODB_URI empty to keep chats in Backend/.data/threads.json.
MONGODB_URI=
DATA_DIR=.data

# ── Free answer providers ──────────────────────────────────────────────────
# Add any key below and that provider is used first, with the others as
# automatic fallbacks. Pin the exact order with PROVIDER_ORDER if you prefer.
#
#   pollinations   no account needed                 https://pollinations.ai
#   groq           free key, fastest                 https://console.groq.com/keys
#   gemini         free tier, long context           https://aistudio.google.com/apikey
#   openrouter     free community models             https://openrouter.ai/keys
#   huggingface    free inference credits            https://huggingface.co/settings/tokens
#   ollama         fully offline, open weights       https://ollama.com/download

# PROVIDER_ORDER=groq,gemini,pollinations

GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
HF_TOKEN=

# ── Model overrides ────────────────────────────────────────────────────────
# POLLINATIONS_MODEL=openai
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.0-flash
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
# OLLAMA_MODEL=llama3.2
# OLLAMA_BASE_URL=http://localhost:11434/v1

# ── Generation ─────────────────────────────────────────────────────────────
# HISTORY_LIMIT=20
# TEMPERATURE=0.7
# MAX_TOKENS=2048
# SYSTEM_PROMPT=You are SigmaGPT, a helpful, direct assistant.
